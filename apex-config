#!/usr/bin/env python3
"""Small Proton-Apex configuration manager.

This tool manages a separate user_settings.py overlay and never edits the
upstream Proton launcher. It supports conservative performance presets and
keeps a backup before changing an existing file.
"""

from __future__ import annotations

import argparse
import ast
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

PRESETS = {
    "balanced": {
        "PROTON_USE_WINED3D": "0",
        "PROTON_NO_D3D11": "0",
        "PROTON_NO_D3D10": "0",
        "PROTON_NO_FSYNC": "0",
        "PROTON_NO_ESYNC": "0",
        "PROTON_FORCE_LARGE_ADDRESS_AWARE": "1",
        "DXVK_STATE_CACHE": "1",
        "DXVK_LOG_LEVEL": "none",
        "DXVK_HUD": "0",
        "VKD3D_DEBUG": "none",
        "VKD3D_SHADER_DEBUG": "none",
        "GST_DEBUG_NO_COLOR": "1",
    },
    "diagnostic": {
        "PROTON_LOG": "1",
        "DXVK_LOG_LEVEL": "info",
        "VKD3D_DEBUG": "warn",
        "VKD3D_SHADER_DEBUG": "fixme",
    },
}


def settings_path() -> Path:
    override = os.environ.get("PROTON_APEX_SETTINGS")
    if override:
        return Path(override).expanduser()
    return Path(__file__).resolve().parent / "user_settings.py"


def load_settings(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
    for node in tree.body:
        if isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "user_settings"
            for target in node.targets
        ):
            value = ast.literal_eval(node.value)
            if not isinstance(value, dict) or not all(
                isinstance(k, str) and isinstance(v, str) for k, v in value.items()
            ):
                raise ValueError("user_settings must be a dict[str, str]")
            return value
    return {}


def write_settings(path: Path, values: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        backup = path.with_suffix(path.suffix + ".bak")
        shutil.copy2(path, backup)
    body = "# Generated by Proton-Apex apex-config; edit with this tool.\n\n"
    body += "user_settings = " + json.dumps(dict(sorted(values.items())), indent=4) + "\n"
    fd, temporary = tempfile.mkstemp(prefix=".user_settings.", dir=path.parent, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(body)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main() -> int:
    parser = argparse.ArgumentParser(description="Proton-Apex configuration manager")
    parser.add_argument("command", choices=("show", "preset", "reset"))
    parser.add_argument("name", nargs="?", choices=tuple(PRESETS))
    args = parser.parse_args()
    path = settings_path()

    if args.command == "show":
        print(json.dumps(load_settings(path), indent=2, sort_keys=True))
        return 0
    if args.command == "reset":
        write_settings(path, PRESETS["balanced"])
        print(f"Wrote balanced settings to {path}")
        return 0
    if not args.name:
        parser.error("preset requires a name: balanced or diagnostic")
    current = load_settings(path)
    current.update(PRESETS[args.name])
    write_settings(path, current)
    print(f"Applied {args.name} preset to {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
