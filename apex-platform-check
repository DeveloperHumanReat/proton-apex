#!/usr/bin/env python3
"""Distribution-neutral Proton-Apex host capability report."""

from __future__ import annotations

import json
import os
import platform
import shutil
import subprocess
from pathlib import Path


def command_version(command: str) -> str | None:
    executable = shutil.which(command)
    if not executable:
        return None
    try:
        result = subprocess.run([executable, "--version"], capture_output=True, text=True, timeout=3)
        return (result.stdout or result.stderr).splitlines()[0][:200]
    except (OSError, subprocess.SubprocessError):
        return "present"


def os_release() -> dict[str, str]:
    values = {}
    path = Path("/etc/os-release")
    if path.exists():
        for line in path.read_text(errors="replace").splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value.strip('"')
    return values


def main() -> int:
    distro = os_release()
    report = {
        "distribution": distro.get("PRETTY_NAME", distro.get("ID", "unknown")),
        "kernel": platform.release(),
        "architecture": platform.machine(),
        "vulkaninfo": command_version("vulkaninfo"),
        "container_engine": command_version("podman") or command_version("docker"),
        "steam": command_version("steam"),
        "kernel_features": {
            "futex_wait_multiple": Path("/proc/sys/kernel/futex_wait_multiple").exists(),
            "ntsync_device": Path("/dev/ntsync").exists(),
        },
        "gpu_tools": {
            "lspci": shutil.which("lspci") is not None,
            "glxinfo": shutil.which("glxinfo") is not None,
        },
    }
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
